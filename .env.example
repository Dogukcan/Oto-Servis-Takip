# Bu dosya şablondur. Gerçek değer YAZMA, boş bırak.
# Gerçek anahtarlar .env.local dosyasında durur, o dosya asla commit edilmez.
#
# Yeni bir dış API eklendiğinde buraya aşağıdaki formatta bir satır eklenecek:
# <DEĞİŞKEN_ADI>=
#   # Nereden alınır: <sağlayıcının dashboard/console adresi>
#   # Yeterli yetki: <en az yetkili scope/rol, "full access" değil>
#   # Önerilen harcama limiti: <sağlayıcı destekliyorsa aylık üst limit>

EXAMPLE_SERVICE_API_KEY=
  # Nereden alınır: (henüz tanımlı bir servis yok, örnek şablondur)
  # Yeterli yetki: (yalnızca kullanılan işlem için en az yetki)
  # Önerilen harcama limiti: (sağlayıcı destekliyorsa düşük bir aylık limit)

# faz3-nextjs/ projesi için: gerçek değer faz3-nextjs/.env.local dosyasına yazılmalı.
YEDEK_KLASORU=
  # Otomatik yedeklemenin servis.db kopyasını yazacağı klasör.
  # Google Drive veya OneDrive masaüstü senkron klasörünün tam yolu olmalı,
  # örn. C:\Users\<kullanici>\OneDrive\ServisYedek
  # Boş bırakılırsa otomatik yedekleme sessizce devre dışı kalır.
